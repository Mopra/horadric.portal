[Unit]
Description=Horadric Town Portal relay
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=horadric
WorkingDirectory=/opt/horadric-portal
# The docker bridge address: Traefik reaches it as host.docker.internal,
# and it is not reachable from the internet.
Environment=HOST=10.0.0.1
Environment=PORT=43200
# Only Traefik reaches it, so the client's address is the X-Real-Ip it sets.
Environment=TRUST_PROXY=1
# The WorkOS client whose access tokens sign in a PC (staging for now).
Environment=WORKOS_CLIENT_ID=client_01M5NBZGRP0NVJ69V5TP9S6PH3,client_01M5NBZGDSBPJMPR5BSJQ9ASEA
# When the relay first saw each signed in PC id, kept across restarts.
# systemd makes it, owned by the service user, writable under ProtectSystem.
StateDirectory=horadric-portal
StateDirectoryMode=0700
Environment=STATE_DIR=/var/lib/horadric-portal
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
